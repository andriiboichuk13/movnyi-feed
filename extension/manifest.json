{
  "manifest_version": 3,
  "name": "Мовний фід",
  "version": "0.1.0",
  "description": "Пропонує україномовні альтернативи відео на YouTube. Дитячий режим ховає російськомовні відео.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "http://localhost/*",
    "https://*.onrender.com/*",
    "https://*.up.railway.app/*",
    "https://*.ngrok-free.app/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "src/config.js",
        "src/selectors.js",
        "src/lang.js",
        "src/content/common.js",
        "src/content/panel.js",
        "src/content/filter.js",
        "src/content/main.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Мовний фід"
  }
}