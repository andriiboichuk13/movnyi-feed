# Скопіюйте цей файл як .env і впишіть свої значення. Сам .env нікуди не публікуйте.
YOUTUBE_API_KEY=ваш_ключ
# Локальний Postgres через Docker (docker compose up -d):
DATABASE_URL=postgresql://movnyi:movnyi_local_pass@localhost:5433/movnyi_feed
# Або спільна база Supabase:
# DATABASE_URL=postgresql://postgres.xxxx:пароль@aws-1-....pooler.supabase.com:5432/postgres
# Посилання на Google-таблицю каналів (доступ «Усі, хто має посилання → Читач») або шлях до CSV-файлу
CHANNELS_SHEET=https://docs.google.com/spreadsheets/d/.../edit#gid=0
